APP_NAME="Health Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:9000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (MySQL 8 — service name "db" inside docker-compose)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=health_dashboard
DB_USERNAME=health_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# LLM integration
# -----------------------------------------------------------------------------
# Which provider answers the LLM contract: "openai" (default) or "anthropic".
LLM_PROVIDER=openai
#
# If the chosen provider has no API key (or a call fails), the app degrades to a
# deterministic FALLBACK so it still works end-to-end and flags source=fallback.

# OpenAI (default provider — used because an Anthropic key was not available during development)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_TOKENS=1024
OPENAI_TIMEOUT=30
OPENAI_RETRIES=2

# Anthropic Claude (spec-specified provider — set LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY to use)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TIMEOUT=30
ANTHROPIC_RETRIES=2

# Placeholder user id used until real authentication is introduced
DEFAULT_USER_ID=1
