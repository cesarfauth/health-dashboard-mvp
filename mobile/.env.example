# Base URL of the Laravel backend API.
#
# - iOS simulator / web:           http://localhost:9000/api
# - Android emulator:              http://10.0.2.2:9000/api
# - Physical device (Expo Go):     http://<YOUR-MACHINE-LAN-IP>:9000/api
#   (find it with `ipconfig` on Windows / `ifconfig` on macOS, e.g. 192.168.0.12)
EXPO_PUBLIC_API_URL=http://localhost:9000/api
